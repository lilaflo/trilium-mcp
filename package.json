{
  "name": "trilium-mcp-server",
  "version": "1.3.0",
  "description": "MCP server for Trilium Notes integration",
  "type": "module",
  "main": "mcp-trilium-server.ts",
  "scripts": {
    "start": "dotenvx run node mcp-trilium-server.ts",
    "dev": "dotenvx run node --watch mcp-trilium-server.ts",
    "build": "echo \"No build step required for TypeScript\"",
    "lint": "echo \"Add linting script here\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose"
  },
  "keywords": [
    "mcp",
    "trilium",
    "notes",
    "server"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.8.3",
    "node-fetch": "^3.3.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.0",
    "@flydotio/dockerfile": "^0.7.10",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "^10.0.0",
      "glob": ">=10.5.0",
      "ajv": ">=8.18.0",
      "qs": ">=6.14.2",
      "diff": ">=8.0.3",
      "babel-plugin-istanbul": "^7.0.0",
      "test-exclude": "^7.0.0"
    }
  }
}
